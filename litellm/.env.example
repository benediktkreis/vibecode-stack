LITELLM_MASTER_KEY=...

# Tailscale container (https://login.tailscale.com/admin/settings/keys — reusable key)
TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=litellm-proxy
# true = userspace mode (recommended on Docker Desktop for Mac). false = kernel mode (Linux).
TS_USERSPACE=true

# Stable public Funnel base URL for clients like Cursor (no trailing slash).
# After first `docker compose up`, check MagicDNS in Tailscale Machines for litellm-proxy.
LITELLM_BASE_URL=https://litellm-proxy.tail-xxxxx.ts.net

ALIBABA_CODING_API_KEY=...
OPENROUTER_API_KEY=...
OLLAMA_CLOUD_API_KEY=...
OPENCODE_API_KEY=...
